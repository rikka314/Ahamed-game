        {
          "action": "ask",
          "input": "请逐项说明：意识状态、神志、反应异常、低血压、晕厥、站立不稳、眼前发黑、差点晕倒、能否饮水、能否进食、无法口服。",
          "expectedFactIds": [
            "fact.confusion",
            "fact.hypotension",
            "fact.syncope",
            "fact.inability_oral_intake"
