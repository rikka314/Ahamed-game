          "expectedFactIds": [
            "fact.ketoacidosis",
            "fact.hypertensive_emergency"
          ]
        },
        {
          "action": "test",
          "testId": "test.vital_signs"
        },
        {
          "action": "test",
          "testId": "test.thyroid_function"
        },
        {
          "action": "diagnose",
