  "trajectories": [
    {
      "trajectoryId": "c20.success",
      "kind": "success",
      "steps": [
        {
          "action": "ask",
          "input": "请逐项说明：什么时候、多久、起病、具体症状、有什么特点、什么时候明显、还伴有什么、其他症状、严重吗、加重、变化、影响生活。",
          "expectedFactIds": [
            "fact.onset",
            "fact.primary_pattern",
            "fact.associated_pattern",
            "fact.progression"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：意识状态、神志、反应异常、低血压、晕厥、站立不稳、能否饮水、能否进食、无法口服、妊娠、免疫抑制、重要基础病。",
          "expectedFactIds": [
            "fact.confusion",
            "fact.hypotension",
            "fact.inability_oral_intake",
            "fact.high_risk_population"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：会阴麻木、尿潴留、大小便失禁、严重外伤、无法负重、摔伤撞伤、发热寒战、关节感染、近期关节操作、肿瘤病史、夜间进行性疼痛、无法解释的体重下降。",
          "expectedFactIds": [
            "fact.cauda_equina",
            "fact.major_trauma",
            "fact.musculoskeletal_infection",
            "fact.malignancy_warning"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：进行性无力、感觉缺失、步态恶化。",
          "expectedFactIds": [
            "fact.progressive_neurologic_deficit"
          ]
        },
        {
          "action": "test",
          "testId": "test.vital_signs"
        },
        {
          "action": "test",
          "testId": "test.neurologic_exam"
        },
        {
          "action": "diagnose",
          "primaryDiagnosis": "机械性腰痛",
          "differentials": [
            "腰椎间盘突出",
            "肾绞痛"
          ]
        }
      ],
      "expected": {
        "diagnosisMatch": "exact",
        "medicalTurns": 4
      }
    },
    {
      "trajectoryId": "c20.failure",
      "kind": "failure",
      "steps": [
        {
