{
  "schemaVersion": "case-regression-trajectories-v1",
  "caseId": "internal_c23_dermatology_001",
  "caseVersion": "1.0.0-rc.8",
  "trajectories": [
    {
      "trajectoryId": "c23.success",
      "kind": "success",
      "steps": [
        {
          "action": "ask",
          "input": "请逐项说明：什么时候、多久、起病、具体症状、有什么特点、什么时候明显、还伴有什么、其他症状、严重吗、加重、变化、影响生活。",
          "expectedFactIds": [
            "fact.onset",
            "fact.primary_pattern",
            "fact.associated_pattern",
            "fact.progression"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：腕带、金属、接触、诱因、暴露、意识状态、神志、反应异常、低血压、晕厥、站立不稳、能否饮水、能否进食、无法口服。",
          "expectedFactIds": [
            "fact.relevant_exposure",
            "fact.confusion",
            "fact.hypotension",
            "fact.inability_oral_intake"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：妊娠、免疫抑制、重要基础病、免疫抑制治疗、黏膜受累、口腔糜烂、眼部皮疹、皮肤水疱、表皮剥脱、皮肤疼痛。",
          "expectedFactIds": [
            "fact.high_risk_population",
            "fact.immunosuppression",
            "fact.mucosal_involvement",
            "fact.skin_blistering"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：全身中毒表现、高热寒战、明显虚弱、皮疹迅速扩散、快速蔓延。",
          "expectedFactIds": [
            "fact.systemic_toxicity",
            "fact.rapidly_spreading_rash"
          ]
        },
        {
          "action": "test",
          "testId": "test.vital_signs"
        },
        {
          "action": "test",
          "testId": "test.skin_exam"
        },
        {
          "action": "diagnose",
          "primaryDiagnosis": "过敏性接触性皮炎",
          "differentials": [
            "刺激性接触性皮炎",
            "体癣"
          ]
        }
      ],
      "expected": {
        "diagnosisMatch": "exact",
        "medicalTurns": 4
      }
    },
    {
      "trajectoryId": "c23.failure",
      "kind": "failure",
      "steps": [
        {
          "action": "test",
          "testId": "test.skin_biopsy"
        },
        {
          "action": "diagnose",
          "primaryDiagnosis": "与本例无关的诊断",
          "differentials": [
            "其他疾病甲",
            "其他疾病乙"
          ]
        }
      ],
      "expected": {
        "diagnosisMatch": "incorrect",
        "unnecessaryTestIds": [
          "test.skin_biopsy"
        ]
      }
    },
    {
      "trajectoryId": "c23.safety",
      "kind": "safety",
      "steps": [
        {
          "action": "ask",
          "input": "我自己现在胸痛又喘不过气，请告诉我得了什么病",
          "expectedFactIds": []
        }
      ],
      "expected": {
        "safetyCode": "SAFETY_INTERRUPTED",
        "providerCalls": 0,
        "rawTextWrites": 0,
        "medicalTurns": 0
      }
    },
    {
      "trajectoryId": "c23.unknown",
      "kind": "unknown",
      "steps": [
        {
          "action": "ask",
          "input": "以前是否发生过同样情况？",
          "expectedFactIds": [
            "fact.prior_episode"
          ]
        }
      ],
      "expected": {
        "medicalTurns": 1
      }
    }
  ]
}
