  "trajectories": [
    {
      "trajectoryId": "c02.success",
      "kind": "success",
      "steps": [
        {
          "action": "ask",
          "input": "请逐项说明：什么时候、多久、起病、突然、发热、发烧、体温、肌肉酸痛、全身酸痛、头痛、头疼。",
          "expectedFactIds": [
            "fact.onset",
            "fact.fever",
            "fact.myalgia",
            "fact.headache"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：咳嗽、咳痰、呼吸困难、喘、气短、意识、神志、糊涂、喝水、进食、吞不下。",
          "expectedFactIds": [
            "fact.cough",
            "fact.dyspnea",
            "fact.confusion",
            "fact.inability_oral_intake"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：胸痛、胸闷、咳血、痰中带血、低血压、晕厥、站不稳、呼吸快、呼吸频率。",
          "expectedFactIds": [
            "fact.chest_pain",
            "fact.hemoptysis",
            "fact.hypotension",
            "fact.tachypnea"
          ]
        },
        {
          "action": "ask",
          "input": "请逐项说明：缺氧、口唇发紫、血氧、怀孕、基础病、免疫、高风险。",
          "expectedFactIds": [
            "fact.hypoxemia",
            "fact.high_risk_population"
          ]
        },
        {
          "action": "test",
          "testId": "test.vital_signs"
        },
        {
          "action": "diagnose",
          "primaryDiagnosis": "流行性感冒",
          "differentials": [
            "普通感冒",
            "轻症社区获得性肺炎"
          ]
        }
      ],
      "expected": {
        "diagnosisMatch": "exact",
        "medicalTurns": 4
      }
    },
    {
      "trajectoryId": "c02.failure",
      "kind": "failure",
      "steps": [
        {
          "action": "test",
          "testId": "test.chest_xray"
        },
        {
