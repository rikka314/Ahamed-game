{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahamed.internal/model/schemas/rubric-v1.schema.json",
  "title": "Private ScoringRubric v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mustAskFactIds",
    "acceptableDifferentialConceptIds",
    "requiredDifferentialCount",
    "testClassifications",
    "recommendedTurnLimit",
    "communicationRubricVersion",
    "communicationCriterionIds"
  ],
  "properties": {
    "mustAskFactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "acceptableDifferentialConceptIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "requiredDifferentialCount": { "const": 2 },
    "testClassifications": {
      "type": "object",
      "additionalProperties": { "enum": ["required", "useful", "unnecessary"] }
    },
    "recommendedTurnLimit": { "type": "integer", "minimum": 1, "maximum": 20 },
    "communicationRubricVersion": { "$ref": "#/$defs/nonEmpty" },
    "communicationCriterionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
