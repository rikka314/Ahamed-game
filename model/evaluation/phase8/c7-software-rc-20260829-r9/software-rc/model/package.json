{
  "name": "@ahamed/doctor-game-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side case orchestration and virtual patient model boundary for AhaMed Doctor Game.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm --prefix ../share run build",
    "build": "npm run clean && tsc -p tsconfig.json",
    "pretypecheck": "npm --prefix ../share run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && npm run test:coverage:global && npm run test:coverage:state-machine && npm run test:coverage:scoring && npm run test:coverage:safety",
    "test:coverage:global": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test-coverage-include=\"dist/src/**/*.js\" --test-coverage-exclude=\"dist/src/headless/**/*.js\" \"dist/tests/**/*.test.js\"",
    "test:coverage:state-machine": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test-coverage-include=\"dist/src/domain/session.js\" \"dist/tests/**/*.test.js\"",
    "test:coverage:scoring": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test-coverage-include=\"dist/src/evaluation/scoring-policy-v1.js\" --test-coverage-include=\"dist/src/evaluation/diagnosis-matcher.js\" --test-coverage-include=\"dist/src/safety/evaluation-output-gate.js\" \"dist/tests/**/*.test.js\"",
    "test:coverage:safety": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test-coverage-include=\"dist/src/safety/medical-safety-policy-v1.js\" --test-coverage-include=\"dist/src/safety/prompt-injection-policy.js\" --test-coverage-include=\"dist/src/safety/patient-output-gate.js\" --test-coverage-include=\"dist/src/safety/evaluation-output-gate.js\" \"dist/tests/**/*.test.js\"",
    "test:contract": "npm --prefix ../share run test:contract && npm run build && node --test \"dist/tests/contract/**/*.test.js\"",
    "headless": "npm run build && node dist/src/headless/runner.js",
    "cli": "npm run build && node --env-file-if-exists=.env dist/src/cli/main.js",
    "cli:local-dev": "npm run build && node --env-file-if-exists=.env dist/src/cli/local-dev-main.js",
    "ops:inspect": "npm run build && node dist/src/ops/runner.js inspect",
    "ops:recover": "npm run build && node dist/src/ops/runner.js recover",
    "cases:validate": "npm run build && node dist/src/cases/phase6-runner.js",
    "cases:validate:dialogue": "npm run build && node dist/src/cases/dialogue-candidate-runner.js",
    "eval:phase7:offline": "npm run build && node dist/src/evaluation/phase7-offline-runner.js",
    "eval:live": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/openai-live-eval-runner.js",
    "eval:live:anthropic": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/anthropic-live-eval-runner.js",
    "phase8:ai-validate": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/phase8-ai-evidence-runner.js",
    "c7:ai-release": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/c7-ai-release-runner.js",
    "c7:dialogue-live": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/c7-dialogue-live-runner.js",
    "c6:accept": "npm run build && node dist/src/release/c6-acceptance-runner.js",
    "c7:accept": "npm run build && node dist/src/release/c7-acceptance-runner.js",
    "c7:manifest": "npm run build && node dist/src/release/c7-runtime-manifest-runner.js",
    "c7:bundle": "npm run build && node dist/src/release/c7-software-rc-runner.js",
    "eval:phase8:candidate": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/phase8-candidate-live-runner.js --kind candidate --repeats 3 --prompt-version v0.2.0",
    "eval:phase8:release": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/phase8-candidate-live-runner.js --kind release --repeats 5 --prompt-version v0.2.0",
    "phase8:patient-audit": "npm run build && node --env-file-if-exists=.env dist/src/evaluation/phase8-patient-audit-runner.js",
    "phase8:manifest": "npm run build && node dist/src/release/phase8-manifest-runner.js",
    "phase8:verify": "npm run build && node dist/src/release/phase8-verify-runner.js",
    "phase8:security-scan": "npm run build && node dist/src/release/phase8-security-scan-runner.js",
    "security:scan": "npm run phase8:security-scan"
  },
  "dependencies": {
    "@ahamed/doctor-game-share": "file:../share",
    "@anthropic-ai/sdk": "0.119.0",
    "openai": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
