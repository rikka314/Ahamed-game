{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahamed.internal/model/schemas/reviewer-qualification-v1.schema.json",
  "title": "Private reviewer qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewerId", "displayName", "credentialType", "maskedCredentialNumber", "credentialNumberHmac", "registrationStatus", "practiceCategory", "practiceScopes", "verificationSource", "verifiedAt", "independentOfAuthor", "conflictOfInterestDeclaration"],
  "properties": {
    "schemaVersion": { "const": "reviewer-qualification-v1" },
    "reviewerId": { "$ref": "#/$defs/id" },
    "displayName": { "$ref": "#/$defs/nonEmpty" },
    "credentialType": { "const": "physician-practice-certificate" },
    "maskedCredentialNumber": { "$ref": "#/$defs/nonEmpty" },
    "credentialNumberHmac": { "type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$" },
    "registrationStatus": { "enum": ["active", "inactive", "unverified"] },
    "practiceCategory": { "$ref": "#/$defs/nonEmpty" },
    "practiceScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "verificationSource": { "$ref": "#/$defs/nonEmpty" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "independentOfAuthor": { "type": "boolean" },
    "conflictOfInterestDeclaration": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
