# Interactive CLI uses a real OpenAI Responses-compatible Patient Agent.
# deterministic is test-only and is rejected by the playable CLI.
AHAMED_MODEL_PROVIDER=openai
AHAMED_MODEL_ID=
AHAMED_MODEL_DATABASE_PATH=./var/model-cli.sqlite
# Optional web runtime database. Defaults to ./var/model-web.sqlite.
AHAMED_WEB_MODEL_DATABASE_PATH=./var/model-web.sqlite
# Expired sessions and their dialogue are deleted after this additional grace period.
AHAMED_WEB_EXPIRED_SESSION_RETENTION_HOURS=168
# Optional alternative to CLI --user for controlled local runs.
AHAMED_CLI_USER_ID=
# At least 32 characters. Required for restart-stable safety HMAC fingerprints,
# response-buffer integrity tags, and pending-turn AEAD encryption.
SAFETY_AUDIT_HMAC_KEY=

# Copy this file to model/.env for local AI CLI/live-eval runs. model/.env is ignored.
# Official OpenAI: set only OPENAI_API_KEY and leave MODEL_BASE_URL/MODEL_API_KEY empty.
# Never commit a real key.
OPENAI_API_KEY=
AHAMED_PROMPT_VERSION=v0.4.0

# Reserved for a future Claude live-eval decision. The current MVP does not
# configure Anthropic credentials and uses only MODEL_BASE_URL + MODEL_API_KEY.
# ANTHROPIC_API_KEY=

# Third-party OpenAI Responses-compatible API: set BOTH values below.
# Also replace AHAMED_MODEL_ID above with the provider's model ID.
# The URL is the API root that exposes POST <baseURL>/responses, normally .../v1.
# Only absolute public HTTPS URLs without credentials/query/fragment are accepted.
MODEL_BASE_URL=
MODEL_API_KEY=

# OPENAI_BASE_URL is intentionally unsupported and ignored. This prevents an
# OpenAI key from being redirected by a conventional SDK environment variable.
# ANTHROPIC_BASE_URL is also intentionally unsupported and ignored; the Claude
# adapter is pinned to the official https://api.anthropic.com Messages endpoint.
