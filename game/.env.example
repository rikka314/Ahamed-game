# The web runtime reads model/.env during local development. Production must
# provide an absolute path on a private writable volume.
AHAMED_MODEL_ID=
AHAMED_WEB_MODEL_DATABASE_PATH=
AHAMED_WEB_EXPIRED_SESSION_RETENTION_HOURS=168
SAFETY_AUDIT_HMAC_KEY=

# Required in production. Enable only behind a reverse proxy that overwrites
# X-Forwarded-For/Host/Proto with one unambiguous value each, and pair it with
# the platform's distributed rate limiter.
AHAMED_TRUST_PROXY_HEADERS=false

# Official OpenAI: set OPENAI_API_KEY only.
OPENAI_API_KEY=

# Third-party OpenAI Responses-compatible endpoint: set both values.
MODEL_BASE_URL=
MODEL_API_KEY=
